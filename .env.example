SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (one Product per tier in the Stripe dashboard)
# Display amounts are loaded live from these Price objects via /api/plan-prices.
# Fallback catalog (shared/planPrices.js): Solo $39/mo; Business $99/mo or $990/yr; Enterprise $199/mo or $1,990/yr.
# Solo: monthly only
STRIPE_PRICE_SOLO_MONTHLY=
# Small / Business
STRIPE_PRICE_SMALL_MONTHLY=
STRIPE_PRICE_SMALL_ANNUAL=
# Enterprise
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Integrations (Asana first)
INTEGRATION_TOKEN_ENCRYPTION_KEY=   # min 16 chars; never store in the database
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
# Optional override; default is {APP_ORIGIN}/api/integrations/asana/callback
ASANA_REDIRECT_URI=
APP_ORIGIN=                         # e.g. https://your-domain.com (OAuth + webhooks)
