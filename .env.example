SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (one Product per tier in the Stripe dashboard)
# Solo: monthly only — $59
STRIPE_PRICE_SOLO_MONTHLY=
# Small: $149/mo or $1,490/yr
STRIPE_PRICE_SMALL_MONTHLY=
STRIPE_PRICE_SMALL_ANNUAL=
# Enterprise: $299/mo or $2,990/yr
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Blog CMS admin (/admin/blog) — long random secret; never commit the real value
BLOG_ADMIN_PASSWORD=

# Weekly auto-drafted blog article (api/cron-draft-article.js)
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". Long random string.
CRON_SECRET=
# Optional: email when a draft is ready (Resend). Skip both to disable emails.
RESEND_API_KEY=
BLOG_NOTIFY_EMAIL=
# BLOG_NOTIFY_FROM=ChangeView <notify@yourdomain.com>
